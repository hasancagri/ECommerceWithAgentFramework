{
  "IdentityOption": {
    "Address": "https://localhost:5001",
    "Issuer": "https://localhost:5001",
    "Audience": "mcp-gateway.api"
  },
  "FacadeOption": {
    "DiscoveryClientId": "mcp-gateway-discovery",
    "DiscoveryClientSecret": "mcp-gateway-discovery-secret",
    "DiscoveryScope": "basket.read order.read customer.read payment.read catalog.write stock.write merchant.credentials.write discount.admin.write",
    "CacheTtlSeconds": 60,
    "RequireLoginUpfront": true,
    "Downstreams": [
      {
        "Name": "storefront",
        "McpUrl": "http://storefront-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": false
      },
      {
        "Name": "catalog",
        "McpUrl": "http://catalog-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": false
      },
      {
        "Name": "basket",
        "McpUrl": "http://basket-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "order",
        "McpUrl": "http://order-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "customer",
        "McpUrl": "http://customer-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "payment",
        "McpUrl": "http://payment-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "reviews",
        "McpUrl": "http://reviews-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "library",
        "McpUrl": "http://library-api/mcp",
        "Surface": "customer",
        "RequiresUserAuth": true
      },
      {
        "Name": "catalog-admin",
        "McpUrl": "http://catalog-api/mcp-admin",
        "Surface": "admin",
        "RequiresUserAuth": true
      },
      {
        "Name": "stock-admin",
        "McpUrl": "http://stock-api/mcp-admin",
        "Surface": "admin",
        "RequiresUserAuth": true
      },
      {
        "Name": "customer-admin",
        "McpUrl": "http://customer-api/mcp-admin",
        "Surface": "admin",
        "RequiresUserAuth": true
      },
      {
        "Name": "discount-admin",
        "McpUrl": "http://discount-api/mcp-admin",
        "Surface": "admin",
        "RequiresUserAuth": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}