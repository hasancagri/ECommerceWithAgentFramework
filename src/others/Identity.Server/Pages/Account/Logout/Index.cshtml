@page
@model Identity.Server.Pages.Logout.Index

<div class="logout-page">
    <div class="lead">
        <h1>Logout</h1>
        <p>Çıkış yapmak istediğinize emin misiniz?</p>
    </div>

    <form asp-page="/Account/Logout/Index">
        <input type="hidden" asp-for="LogoutId" />
        <button class="btn btn-primary" name="Input.Button" value="logout">Evet, çıkış yap</button>
    </form>
</div>