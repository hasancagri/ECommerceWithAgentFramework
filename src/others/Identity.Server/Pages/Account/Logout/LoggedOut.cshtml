@page
@model Identity.Server.Pages.Logout.LoggedOut

<div class="logged-out-page">
    <div class="lead">
        <h1>Çıkış yapıldı</h1>
        <p>Oturumunuz başarıyla kapatıldı.</p>
    </div>

    @if (Model.View.PostLogoutRedirectUri != null)
    {
        <p>
            <a class="btn btn-primary PostLogoutRedirectUri" href="@Model.View.PostLogoutRedirectUri">
                @(string.IsNullOrEmpty(Model.View.ClientName) ? "Uygulamaya dön" : $"{Model.View.ClientName} uygulamasına dön")
            </a>
        </p>
    }
    else
    {
        <p><a class="btn btn-primary" href="https://localhost:7042/">Mağazaya dön</a></p>
    }

    @if (Model.View.SignOutIframeUrl != null)
    {
        <iframe width="0" height="0" class="signout" src="@Model.View.SignOutIframeUrl"></iframe>
    }
</div>

@if (Model.View.AutomaticRedirectAfterSignOut)
{
    <script src="~/js/signout-redirect.js"></script>
}