{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FeedPullOptions": {
    "PullCron": "*/30 * * * *",
    "FirstPullDelaySeconds": 60
  },
  "SupplierFeedEndpointsOptions": {
    "Paths": {
      "supplier-a": "/v1/feeds/supplier-a",
      "supplier-b": "/v1/feeds/supplier-b"
    }
  }
}