<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
        <PackageReference Include="Marten" />
        <PackageReference Include="Marten.Newtonsoft" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Scrutor" />
        <PackageReference Include="WolverineFx" />
        <PackageReference Include="WolverineFx.RuntimeCompilation" />
        <PackageReference Include="WolverineFx.Http" />
        <PackageReference Include="WolverineFx.Marten" />
        <PackageReference Include="WolverineFx.Postgresql" />
        <PackageReference Include="WolverineFx.RabbitMQ" />
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Grpc.Net.ClientFactory" />
        <PackageReference Include="Grpc.AspNetCore" />
        <PackageReference Include="Google.Protobuf" />
        <PackageReference Include="Grpc.Tools">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- 012: Stock rezervasyon istemcisi; 028: Basket ClearBasket istemcisi (paylaşılan protolar). -->
    <ItemGroup>
        <Protobuf Include="..\..\..\others\Shared\Protos\stock_reservation.proto" GrpcServices="Client" />
        <Protobuf Include="..\..\..\others\Shared\Protos\basket_clear.proto" GrpcServices="Client" />
        <!-- 039: sepet kalemleri okuma istemcisi (chat siparis tamamlama). -->
        <Protobuf Include="..\..\..\others\Shared\Protos\basket_items.proto" GrpcServices="Client" />
        <!-- 044: satin-alma kaniti sunucusu (Reviews istemci). -->
        <Protobuf Include="..\..\..\others\Shared\Protos\order_purchase.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\others\Common\Common.csproj" />
      <ProjectReference Include="..\..\..\others\Shared\Shared.csproj" />
      <ProjectReference Include="..\..\..\aspire\ServiceDefaults\ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
