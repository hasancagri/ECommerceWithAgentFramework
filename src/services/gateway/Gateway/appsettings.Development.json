{
  "ReverseProxy": {
    "Routes": {
      "basket-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/baskets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/baskets/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "catalog-route": {
        "ClusterId": "catalog.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/catalogs/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ClientCredential"
      },
      "catalog-mcp-route": {
        "ClusterId": "catalog.cluster",
        "Match": {
          "Path": "/mcp/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "basket-mcp-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "/mcp/basket/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "order-mcp-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "/mcp/order/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "payment-mcp-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "/mcp/payment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "stock-mcp-route": {
        "ClusterId": "stock.cluster",
        "Match": {
          "Path": "/mcp/stock/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/orders/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "payment-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/payments/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "storefront-route": {
        "ClusterId": "storefront.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/storefront/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/storefront/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ClientCredential"
      },
      "storefront-mcp-route": {
        "ClusterId": "storefront.cluster",
        "Match": {
          "Path": "/mcp/storefront/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "customer-addresses-route": {
        "ClusterId": "customer.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/addresses/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/addresses/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
