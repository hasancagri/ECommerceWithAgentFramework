        }
      },
      "reviews-mcp-route": {
        "ClusterId": "reviews.cluster",
        "Match": {
          "Path": "/mcp/reviews/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "reviews-prm-route": {
        "ClusterId": "reviews.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/reviews"
