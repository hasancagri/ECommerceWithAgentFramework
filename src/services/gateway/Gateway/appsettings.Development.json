      "reviews-route": {
        "ClusterId": "reviews.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/reviews/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/reviews/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "basket.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket-api"
          }
        }
      },
      "catalog.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "order.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-api"
          }
        }
      },
      "payment.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-api"
          }
        }
      },
      "stock.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://stock-api"
          }
        }
      },
      "storefront.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://storefront-api"
          }
        }
      },
      "customer.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customer-api"
          }
        }
      },
      "reviews.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-api"
          }
        }
      }
