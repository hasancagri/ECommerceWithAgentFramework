{
  "ReverseProxy": {
    "Routes": {
      "catalog-mcp-route": {
        "ClusterId": "catalog.cluster",
        "Match": {
          "Path": "/mcp/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "basket-mcp-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "/mcp/basket/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "order-mcp-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "/mcp/order/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "payment-mcp-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "/mcp/payment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "stock-mcp-route": {
        "ClusterId": "stock.cluster",
        "Match": {
          "Path": "/mcp/stock/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "storefront-mcp-route": {
        "ClusterId": "storefront.cluster",
        "Match": {
          "Path": "/mcp/storefront/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "customer-mcp-route": {
        "ClusterId": "customer.cluster",
        "Match": {
          "Path": "/mcp/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "basket-prm-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/basket"
        }
      },
      "order-prm-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/order"
        }
      },
      "customer-prm-route": {
        "ClusterId": "customer.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/customer"
        }
      },
      "payment-prm-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/payment"
        }
      },
      "reviews-mcp-route": {
        "ClusterId": "reviews.cluster",
        "Match": {
          "Path": "/mcp/reviews/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "reviews-prm-route": {
        "ClusterId": "reviews.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/reviews"
        }
      },
      "library-mcp-route": {
        "ClusterId": "library.cluster",
        "Match": {
          "Path": "/mcp/library/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/mcp/{**catch-all}"
          }
        ]
      },
      "library-prm-route": {
        "ClusterId": "library.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp/library"
        }
      },
      "files-route": {
        "ClusterId": "file.cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        }
      },
      "mcp-facade-route": {
        "ClusterId": "mcp-gateway.cluster",
        "Match": {
          "Path": "/mcp"
        }
      },
      "mcp-facade-prm-route": {
        "ClusterId": "mcp-gateway.cluster",
        "Match": {
          "Path": "/.well-known/oauth-protected-resource/mcp"
        }
      }
    },
    "Clusters": {
      "mcp-gateway.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://mcp-gateway"
          }
        }
      },
      "library.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://library-api"
          }
        }
      },
      "basket.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket-api"
          }
        }
      },
      "catalog.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "order.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://order-api"
          }
        }
      },
      "payment.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payment-api"
          }
        }
      },
      "stock.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://stock-api"
          }
        }
      },
      "storefront.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://storefront-api"
          }
        }
      },
      "customer.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customer-api"
          }
        }
      },
      "reviews.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-api"
          }
        }
      },
      "file.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://file-api"
          }
        }
      }
    }
  },
  "IdentityOption": {
    "Address": "https://localhost:5001",
    "Issuer": "https://localhost:5001",
    "Audience": "gateway.api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
