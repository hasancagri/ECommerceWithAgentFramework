@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">


        @if (!Model.Products.Any())
        {
            <div class="col">
                <div class="alert alert-warning" role="alert">
                    No Products Found!
                </div>
            </div>
            return;
        }

        @foreach (var product in Model.Products!)
        {
            <div class="col">
                <div class="card h-100 shadow-lg border-0">
                    <a asp-page="/Products/Detail" asp-route-id="@product.ProductId">
                        <img
                            src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/NoImage.jpeg" : product.ImageUrl)"
                            class="card-img-top" alt="@product.Name">
                    </a>

                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">
                            @* FR-009: stok null = bilinmiyor, rozet yok; 0 = stokta yok; >0 = stokta. *@
                            @if (product.IsInStock == true)
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                            else if (product.IsInStock == false)
                            {
                                <span class="badge bg-secondary">Out of Stock</span>
                            }
                            @if (product.DiscountRate is not null)
                            {
                                <span class="badge bg-danger">%@((product.DiscountRate.Value * 100).ToString("0.#")) Off</span>
                            }
                        </p>
                        <p class="card-text">@product.TruncateDescription(100)</p>
                        <p class="card-text">
                            <small class="text-muted">Brand: <strong>@product.Brand</strong></small>
                        </p>
                        <p class="card-text">
                            <strong>@product.Price.ToString("C")</strong>
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Products/Detail" asp-route-id="@product.ProductId" class="btn btn-primary mt-2">Show
                            Detail</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>