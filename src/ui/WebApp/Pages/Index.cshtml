@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">


        @if (!Model.Products.Any())
        {
            <div class="col">
                <div class="alert alert-warning" role="alert">
                    No Products Found!
                </div>
            </div>
            return;
        }

        @* 011 US2: kart, Tüm Ürünler ile ortak partial'dan çizilir (FR-008). *@
        @foreach (var product in Model.Products!)
        {
            <partial name="_ProductCard" model="product"/>
        }
    </div>

    @* 011 US2: dashboard ilk 8 ürünü gösterir; tamamı Tüm Ürünler ekranında (FR-007). *@
    <div class="text-center mt-4">
        <a asp-page="/Products/Index" class="btn btn-outline-primary">View All Products</a>
    </div>
</div>