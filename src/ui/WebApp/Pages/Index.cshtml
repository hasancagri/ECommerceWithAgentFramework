@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

@* Hero — kitapyurdu-tarzı sıcak karşılama. *@
<div class="kp-hero">
    <div class="container text-center py-5">
        <h1 class="kp-hero-title">📚 Binlerce Kitap, Tek Çatı Altında</h1>
        <p class="kp-hero-sub">Yazarlar, yayınevleri ve türler — aradığın kitap burada.</p>
        <a asp-page="/Products/Index" class="btn kp-hero-btn">Tüm Kitaplara Göz At</a>
    </div>
</div>

<div class="container mt-4">
    <div class="d-flex align-items-baseline justify-content-between mb-3">
        <h2 class="mb-0">Öne Çıkan Kitaplar</h2>
        <a asp-page="/Products/Index" class="text-decoration-none">Tümünü gör →</a>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="alert alert-warning">Henüz kitap yok.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product"/>
            }
        </div>
    }
</div>