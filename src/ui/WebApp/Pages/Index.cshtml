@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

@* Hero — kitapyurdu-tarzı sıcak karşılama. *@
<div class="kp-hero">
    <div class="container text-center py-5">
        <h1 class="kp-hero-title">📚 Binlerce Kitap, Tek Çatı Altında</h1>
        <p class="kp-hero-sub">Yazarlar, yayınevleri ve türler — aradığın kitap burada.</p>
        <a asp-page="/Products/Index" class="btn kp-hero-btn">Tüm Kitaplara Göz At</a>
    </div>
</div>

<div class="container mt-4">
    @* 053: çoklu-kuşak kişisel feed. Cold-start'ta tek "Öne çıkan kitaplar" kuşağı (FR-011). *@
    @if (!Model.Feed.Shelves.Any(s => s.Products.Any()))
    {
        <div class="alert alert-warning">Henüz kitap yok.</div>
    }
    else
    {
        @for (var i = 0; i < Model.Feed.Shelves.Count; i++)
        {
            <partial name="_RecommendationShelf" model="Model.Feed.Shelves[i]"
                     view-data='new ViewDataDictionary(ViewData) { { "ShelfIndex", i }, { "IsColdStart", Model.Feed.IsColdStart } }'/>
        }
    }
</div>

@section Scripts {
    <script>
        // 053: waterfall load-more — kuşağın sonraki offset kartlarını çekip ekler; boş dönerse buton gizlenir.
        async function loadMoreShelf(btn) {
            const shelf = btn.dataset.shelf;
            let offset = parseInt(btn.dataset.offset, 10);
            const grid = document.getElementById('shelf-grid-' + shelf);
            btn.disabled = true;
            try {
                const res = await fetch(`?handler=More&shelf=${shelf}&offset=${offset}`);
                if (!res.ok) { btn.remove(); return; }
                const html = (await res.text()).trim();
                if (!html) { btn.remove(); return; }
                grid.insertAdjacentHTML('beforeend', html);
                btn.dataset.offset = offset + 12;
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
