@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

@* Hero — kitapyurdu-tarzı sıcak karşılama. *@
<div class="kp-hero">
    <div class="container text-center py-5">
        <h1 class="kp-hero-title">📚 Binlerce Kitap, Tek Çatı Altında</h1>
        <p class="kp-hero-sub">Yazarlar, yayınevleri ve türler — aradığın kitap burada.</p>
        <a asp-page="/Products/Index" class="btn kp-hero-btn">Tüm Kitaplara Göz At</a>
    </div>
</div>

<div class="container mt-4">
    @* Öne çıkanlar kuşağı. *@
    <section class="kp-band">
        <div class="kp-band-head">
            <h3 class="kp-band-title">Öne Çıkan Kitaplar</h3>
            <a asp-page="/Products/Index" class="kp-band-more">Tümünü Gör →</a>
        </div>
        @if (!Model.Featured.Any())
        {
            <div class="alert alert-warning">Henüz kitap yok.</div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var product in Model.Featured)
                {
                    <partial name="_ProductCard" model="product"/>
                }
            </div>
        }
    </section>
</div>
