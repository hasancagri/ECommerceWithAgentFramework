@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

@* 054: hero sade — genel vitrine ("Tüm Kitaplara Göz At") çağrı yok; ana sayfa saf kişisel. *@
<div class="kp-hero">
    <div class="container text-center py-5">
        <h1 class="kp-hero-title">📚 Binlerce Kitap, Tek Çatı Altında</h1>
        <p class="kp-hero-sub">Yazarlar, yayınevleri ve türler — aradığın kitap burada.</p>
    </div>
</div>

<div class="container mt-4">
    @if (Model.Feed.Any())
    {
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h2 class="mb-0">Sana Özel Kitaplar</h2>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.Feed)
            {
                <partial name="_ProductCard" model="product"/>
            }
        </div>
    }
    else
    {
        @* 054 FR-006: boş durum — ürün listesi de kategori kartları da YOK; gezinme navbar'dan. *@
        <div class="text-center py-4">
            @if (Model.IsAuthenticated)
            {
                <h2 class="mb-2">Henüz sana özel bir liste yok</h2>
                <p class="text-muted">İlk siparişinden sonra burası okuduğun yazarlara ve türlere göre kişiselleşir.</p>
            }
            else
            {
                <h2 class="mb-2">Keşfe başla</h2>
                <p class="text-muted">Giriş yapıp sipariş verdikçe burası sana göre şekillenir.</p>
            }
        </div>
    }

    @* 055: "Son Gezdiklerim" şeridi — feed'in/boş durumun ALTINDA; liste boşsa istek de yok. *@
    <div id="recently-viewed"></div>
</div>

@section Scripts {
    <script>
        (function () {
            let list;
            try { list = JSON.parse(localStorage.getItem('recentlyViewed')); } catch { list = null; }
            if (!Array.isArray(list) || list.length === 0) return;
            const host = document.getElementById('recently-viewed');
            fetch('/?handler=RecentlyViewed&ids=' + encodeURIComponent(list.join(',')))
                .then(r => r.ok ? r.text() : '')
                .then(html => { if (html.trim()) host.innerHTML = html; })
                .catch(() => { /* vitrin erişilemezse şerit sessizce çizilmez */ });
            // FR-010: "Temizle" — enjekte HTML'deki butonu delegasyonla dinle.
            host.addEventListener('click', e => {
                if (!e.target.closest('[data-clear-recently-viewed]')) return;
                localStorage.removeItem('recentlyViewed');
                host.innerHTML = '';
            });
        })();
    </script>
}