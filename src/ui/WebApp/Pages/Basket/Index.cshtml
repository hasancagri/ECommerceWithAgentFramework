@page
@model IndexModel
@{
    var index = 1;
}

<table class="table table-striped">
    <thead class="table-dark">
    <tr>
        <th scope="col">#</th>
        <th scope="col">Product Picture</th>
        <th scope="col">Product Name</th>
        <th scope="col">Product Price</th>
        <th scope="col">Qty</th>
        <th scope="col">Reservation</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>

    @if (!Model.Basket.HasItem)
    {
        <tr>
            <td colspan="7" class="text-center">No items in the basket.</td>
        </tr>
    }


    @foreach (var basketItem in Model.Basket.Items)
    {
        <tr>
            <td>@index</td>
            <td>
                <img class="img-fluid img-thumbnail" width="100px" alt="@basketItem.Name"
                     src="@(string.IsNullOrEmpty(basketItem.PictureUrl) ? "/images/blank_course_thumbnail.jpg" : basketItem.PictureUrl)">


            </td>

            <td>
                @basketItem.Name
            </td>
            <td>


                @if (Model.Basket.IsApplyDiscountCoupon)
                {
                    <span class="fw-bold">@basketItem.PriceWithDiscountRate!.Value.ToString("C")</span>
                    <span style="text-decoration: line-through;">
                        <text>(@basketItem.Price.ToString("C"))</text>
                    </span>
                }
                else
                {
                    @basketItem.Price.ToString("C")
                }

            </td>

            <td>@basketItem.Quantity</td>

            <td>
                @* 012 (US5): rezervasyon geri sayimi — istemci tarafinda sunucu bitis zamanina gore tiklar. *@
                @if (basketItem.ReservationExpiresAt is { } expiresAt)
                {
                    <span class="reservation-countdown badge bg-info text-dark"
                          data-expires="@expiresAt.UtcDateTime.ToString("O")">…</span>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </td>

            <td>

                <a asp-page-handler="Delete" asp-route-productId="@basketItem.Id" class="btn btn-danger">Remove</a>
            </td>
        </tr>
        index++;
    }
    <tr class="table-active">
        <td colspan="6" class="text-end fw-bold">Total Price:</td>
        <td>@Model.Basket.GetTotalPrice().ToString("C")</td>
    </tr>

    </tbody>
</table>


@if (!Model.Basket.HasItem)
{
    return;
}

@if (Model.Basket.IsApplyDiscountCoupon)
{
    <div class="alert alert-success d-flex justify-content-between" role="alert">
        <span>Discount coupon applied successfully.</span>
        <a asp-page-handler="RemoveDiscount" class="btn btn-warning btn-sm">Remove Coupon (@Model.Basket.Coupon)</a>
    </div>
}


<form method="post" asp-page-handler="ApplyDiscount">
    <div class="input-group mb-3">
        <input type="text" class="form-control" id="couponCode" name="CouponCode" placeholder="Coupon Code" required>
        <button type="submit" class="btn btn-primary">Apply Coupon</button>
    </div>
</form>

<a asp-page="/order/Create" class="btn btn-success w-100 mt-3 text-center">
    <i class="fa-solid fa-credit-card"></i> Proceed to Payment Step
</a>

@section Scripts {
    <script>
        // 012 (US5): her sepet satirinin rezervasyon bitisine gore geri sayimi 1sn'de bir gunceller.
        (function () {
            const els = document.querySelectorAll('.reservation-countdown');
            if (!els.length) return;

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function tick() {
                const now = Date.now();
                els.forEach(el => {
                    const expires = Date.parse(el.dataset.expires);
                    let remaining = Math.floor((expires - now) / 1000);
                    if (isNaN(expires)) { el.textContent = '—'; return; }
                    if (remaining <= 0) {
                        el.textContent = 'Expired';
                        el.classList.remove('bg-info');
                        el.classList.add('bg-secondary', 'text-white');
                        return;
                    }
                    const m = Math.floor(remaining / 60);
                    const s = remaining % 60;
                    el.textContent = pad(m) + ':' + pad(s);
                });
            }

            tick();
            setInterval(tick, 1000);
        })();
    </script>
}