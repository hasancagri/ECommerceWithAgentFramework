@page
@model IndexModel
@{
    var index = 1;
}

@* 017 (FR-011/012): sepet duzeyi TEK rezervasyon banner'i — satir sayaci yok. *@
@if (Model.Basket.HasItem && Model.Basket.ReservationExpiresAt is { } reservationExpiresAt)
{
    <div id="reservation-banner"
         class="alert @(Model.Basket.IsReservationExpired ? "alert-secondary" : "alert-info")"
         role="alert"
         data-expires="@reservationExpiresAt.UtcDateTime.ToString("O")">
        @if (Model.Basket.IsReservationExpired)
        {
            <span>Reservation <strong>expired</strong> — items may be removed from your basket.</span>
        }
        else
        {
            <span>Items reserved for <strong id="reservation-countdown">…</strong></span>
        }
    </div>
}

<table class="table table-striped">
    <thead class="table-dark">
    <tr>
        <th scope="col">#</th>
        <th scope="col">Product Picture</th>
        <th scope="col">Product Name</th>
        <th scope="col">Product Price</th>
        <th scope="col">Qty</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>

    @if (!Model.Basket.HasItem)
    {
        <tr>
            <td colspan="6" class="text-center">No items in the basket.</td>
        </tr>
    }


    @foreach (var basketItem in Model.Basket.Items)
    {
        <tr>
            <td>@index</td>
            <td>
                <img class="img-fluid img-thumbnail" width="100px" alt="@basketItem.Name"
                     src="@(string.IsNullOrEmpty(basketItem.PictureUrl) ? "/images/blank_course_thumbnail.jpg" : basketItem.PictureUrl)">


            </td>

            <td>
                @basketItem.Name
            </td>
            <td>


                @if (Model.Basket.IsApplyDiscountCoupon)
                {
                    <span class="fw-bold">@basketItem.PriceWithDiscountRate!.Value.ToString("C")</span>
                    <span style="text-decoration: line-through;">
                        <text>(@basketItem.Price.ToString("C"))</text>
                    </span>
                }
                else
                {
                    @basketItem.Price.ToString("C")
                }

            </td>

            <td>@basketItem.Quantity</td>

            <td>

                <a asp-page-handler="Delete" asp-route-productId="@basketItem.Id" class="btn btn-danger">Remove</a>
            </td>
        </tr>
        index++;
    }
    <tr class="table-active">
        <td colspan="5" class="text-end fw-bold">Total Price:</td>
        <td>@Model.Basket.GetTotalPrice().ToString("C")</td>
    </tr>

    </tbody>
</table>


@if (!Model.Basket.HasItem)
{
    return;
}

@if (Model.Basket.IsApplyDiscountCoupon)
{
    <div class="alert alert-success d-flex justify-content-between" role="alert">
        <span>Discount coupon applied successfully.</span>
        <a asp-page-handler="RemoveDiscount" class="btn btn-warning btn-sm">Remove Coupon (@Model.Basket.Coupon)</a>
    </div>
}


<form method="post" asp-page-handler="ApplyDiscount">
    <div class="input-group mb-3">
        <input type="text" class="form-control" id="couponCode" name="CouponCode" placeholder="Coupon Code" required>
        <button type="submit" class="btn btn-primary">Apply Coupon</button>
    </div>
</form>

<a asp-page="/order/Create" class="btn btn-success w-100 mt-3 text-center">
    <i class="fa-solid fa-credit-card"></i> Proceed to Payment Step
</a>

@section Scripts {
    <script>
        // 017 (FR-012): sepet duzeyi TEK geri sayim — sunucu mutlak bitisine gore 1sn'de bir tiklar.
        (function () {
            const banner = document.getElementById('reservation-banner');
            const el = document.getElementById('reservation-countdown');
            if (!banner || !el) return;

            const expires = Date.parse(banner.dataset.expires);
            if (isNaN(expires)) return;

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function tick() {
                const remaining = Math.floor((expires - Date.now()) / 1000);
                if (remaining <= 0) {
                    banner.classList.remove('alert-info');
                    banner.classList.add('alert-secondary');
                    banner.innerHTML = '<span>Reservation <strong>expired</strong> — items may be removed from your basket.</span>';
                    clearInterval(timer);
                    return;
                }
                const m = Math.floor(remaining / 60);
                const s = remaining % 60;
                el.textContent = pad(m) + ':' + pad(s);
            }

            tick();
            const timer = setInterval(tick, 1000);
        })();
    </script>
}