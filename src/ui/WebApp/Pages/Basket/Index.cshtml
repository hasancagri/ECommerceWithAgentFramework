@page
@model IndexModel
@{
    var index = 1;
}

@if (!Model.Basket.HasItem)
{
    <div class="text-center py-5">
        <p class="mb-3">Sepetinde ürün yok.</p>
        <a asp-page="/Index" class="btn btn-primary">Alışverişe Başla</a>
    </div>
    return;
}

<table class="table table-striped">
    <thead class="table-dark">
    <tr>
        <th scope="col">#</th>
        <th scope="col">Ürün Görseli</th>
        <th scope="col">Ürün Adı</th>
        <th scope="col">Ürün Fiyatı</th>
        <th scope="col">Adet</th>
        <th>İşlem</th>
    </tr>
    </thead>
    <tbody>

    @foreach (var basketItem in Model.Basket.Items)
    {
        <tr>
            <td>@index</td>
            <td>
                <img class="img-fluid img-thumbnail" width="100px" alt="@basketItem.Name"
                     src="@(string.IsNullOrEmpty(basketItem.PictureUrl) ? "/images/blank_course_thumbnail.jpg" : basketItem.PictureUrl)">


            </td>

            <td>
                @basketItem.Name
            </td>
            <td>
                @basketItem.Price.ToString("C")
            </td>

            <td>
                @* 021: adet stepper — hedef adet (mevcut ± 1) view'dan tasinir; min 1'de − devre disi. *@
                <div class="d-flex align-items-center gap-2">
                    @if (basketItem.Quantity <= 1)
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled>&minus;</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-page-handler="SetQuantity"
                           asp-route-productId="@basketItem.Id" asp-route-quantity="@(basketItem.Quantity - 1)">&minus;</a>
                    }
                    <span class="fw-bold" style="min-width:2ch;text-align:center">@basketItem.Quantity</span>
                    @if (basketItem.Quantity >= basketItem.MaxQuantity)
                    {
                        <button class="btn btn-outline-secondary btn-sm" disabled title="En fazla @basketItem.MaxQuantity adet">+</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-page-handler="SetQuantity"
                           asp-route-productId="@basketItem.Id" asp-route-quantity="@(basketItem.Quantity + 1)">+</a>
                    }
                </div>
            </td>

            <td>

                <a asp-page-handler="Delete" asp-route-productId="@basketItem.Id" class="btn btn-danger">Kaldır</a>
            </td>
        </tr>
        index++;
    }
    <tr class="table-active">
        <td colspan="5" class="text-end fw-bold">Toplam Tutar:</td>
        <td>@Model.Basket.GetTotalPrice().ToString("C")</td>
    </tr>

    </tbody>
</table>

<a asp-page="/order/Create" class="btn btn-success w-100 mt-3 text-center">
    <i class="fa-solid fa-credit-card"></i> Ödeme Adımına Geç
</a>
