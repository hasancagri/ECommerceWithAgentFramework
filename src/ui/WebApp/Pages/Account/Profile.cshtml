@page
@using System.Security.Claims
@model WebApp.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profilim";

    string? ClaimValue(params string[] types) =>
        types.Select(t => User.FindFirstValue(t)).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    var displayName = ClaimValue(ClaimTypes.Name, "name", "preferred_username") ?? User.Identity?.Name;
    var email = ClaimValue(ClaimTypes.Email, "email");
    @* sub/NameIdentifier fallback'i GUID gosteriyordu; gercek kullanici adi yoksa satir gizlenir. *@
    var userName = ClaimValue("preferred_username");
}

<h2 class="mb-4">Profilim</h2>

<div class="card mb-4">
    <div class="card-header">Genel Bilgiler</div>
    <div class="card-body">
        <dl class="row mb-0">
            @if (!string.IsNullOrWhiteSpace(displayName))
            {
                <dt class="col-sm-3">Ad</dt>
                <dd class="col-sm-9">@displayName</dd>
            }
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <dt class="col-sm-3">E-posta</dt>
                <dd class="col-sm-9">@email</dd>
            }
            @if (!string.IsNullOrWhiteSpace(userName))
            {
                <dt class="col-sm-3">Kullanıcı Adı</dt>
                <dd class="col-sm-9">@userName</dd>
            }
        </dl>
    </div>
</div>

<ul class="nav nav-tabs" id="profileTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.Tab == "addresses" ? "active" : "")" id="addresses-tab" data-bs-toggle="tab"
                data-bs-target="#addresses-pane" type="button" role="tab">Adreslerim</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.Tab == "cards" ? "active" : "")" id="cards-tab" data-bs-toggle="tab"
                data-bs-target="#cards-pane" type="button" role="tab">Kartlarım</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.Tab == "orders" ? "active" : "")" id="orders-tab" data-bs-toggle="tab"
                data-bs-target="#orders-pane" type="button" role="tab">Siparişlerim</button>
    </li>
</ul>

<div class="tab-content pt-4" id="profileTabsContent">
    <div class="tab-pane fade @(Model.Tab == "addresses" ? "show active" : "")" id="addresses-pane" role="tabpanel">
        <partial name="_AddressesTab" model="Model"/>
    </div>
    <div class="tab-pane fade @(Model.Tab == "cards" ? "show active" : "")" id="cards-pane" role="tabpanel">
        <partial name="_CardsTab" model="Model"/>
    </div>
    <div class="tab-pane fade @(Model.Tab == "orders" ? "show active" : "")" id="orders-pane" role="tabpanel">
        <partial name="_OrdersTab" model="Model"/>
    </div>
</div>