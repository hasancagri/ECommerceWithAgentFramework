@model WebApp.Pages.Account.ProfileModel

@if (!Model.OrderHistoryList.Any())
{
    <p class="text-muted">Sipariş bulunamadı.</p>
}
else
{
    <div class="accordion" id="orderHistoryAccordion">
        @for (var i = 0; i < Model.OrderHistoryList.Count; i++)
        {
            var order = Model.OrderHistoryList[i];
            var accordionId = $"order-{i}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@accordionId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@accordionId" aria-expanded="false" aria-controls="collapse-@accordionId">
                        <span class="badge @order.BadgeClass me-2">@order.StatusText</span>
                        Sipariş Tarihi: @order.DateTime | Toplam Tutar: @order.TotalPrice
                    </button>
                </h2>
                <div id="collapse-@accordionId" class="accordion-collapse collapse" aria-labelledby="heading-@accordionId" data-bs-parent="#orderHistoryAccordion">
                    <div class="accordion-body">
                        @if (!string.IsNullOrEmpty(order.CancelReasonText))
                        {
                            <div class="alert alert-danger py-2">İptal sebebi: @order.CancelReasonText</div>
                        }
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Ürün Adı</th>
                                <th>Ürün Fiyatı</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in order.GetItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>$@item.UnitPrice</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}