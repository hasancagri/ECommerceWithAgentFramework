@model WebApp.Pages.Account.ProfileModel

<div class="row">
    <div class="col-md-7">
        @if (Model.Cards.Count == 0)
        {
            <div class="alert alert-info">Henüz kayıtlı kartın yok.</div>
        }
        else
        {
            @* Güvenlik gereği kart düzenlenemez: PAN/CVV saklanmadığı için geri getirilemez. *@
            <div class="alert alert-light border small mb-3">
                Kayıtlı kartlar güvenlik nedeniyle düzenlenemez. Değişiklik için kartı silip yeniden ekle.
            </div>
            <div class="list-group mb-4">
                @foreach (var c in Model.Cards)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@c.Brand •••• @c.Last4</strong>
                            @if (c.IsDefault)
                            {
                                <span class="badge bg-success ms-2">Varsayılan</span>
                            }
                            <div class="text-muted small">
                                SKT @c.ExpiryMonth.ToString("00")/@c.ExpiryYear
                                @if (!string.IsNullOrWhiteSpace(c.Label))
                                {
                                    <span>— @c.Label</span>
                                }
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm">
                            @if (!c.IsDefault)
                            {
                                <a class="btn btn-outline-success" asp-page-handler="SetDefaultCard" asp-route-id="@c.Id">Varsayılan Yap</a>
                            }
                            <a class="btn btn-outline-danger" asp-page-handler="DeleteCard" asp-route-id="@c.Id"
                               onclick="return confirm('Bu kart silinsin mi?');">Sil</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header">Yeni Kart Ekle</div>
            <div class="card-body">
                <form method="post" asp-page-handler="AddCard" class="row g-2" autocomplete="off">
                    <div class="col-12">
                        <input class="form-control" asp-for="CardForm.Pan" placeholder="Kart numarası" inputmode="numeric" autocomplete="off" required/>
                    </div>
                    <div class="col-4">
                        <input class="form-control" asp-for="CardForm.ExpiryMonth" placeholder="MM" inputmode="numeric" min="1" max="12" required/>
                    </div>
                    <div class="col-4">
                        <input class="form-control" asp-for="CardForm.ExpiryYear" placeholder="YYYY" inputmode="numeric" min="2000" max="2099" required/>
                    </div>
                    <div class="col-4">
                        <input class="form-control" asp-for="CardForm.Cvv" placeholder="CVV" inputmode="numeric" autocomplete="off" required/>
                    </div>
                    <div class="col-12">
                        <input class="form-control" asp-for="CardForm.Label" placeholder="Etiket (opsiyonel, örn. iş kartı)"/>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary w-100" type="submit">Kart Ekle</button>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">Kart numarası ve CVV asla saklanmaz — yalnızca güvenli bir token, marka ve son 4 hane tutulur.</small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>