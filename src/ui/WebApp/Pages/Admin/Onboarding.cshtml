@page
@model WebApp.Pages.Admin.OnboardingModel
@{
    ViewData["Title"] = "Merchant Onboarding";
}

<div class="container my-4" style="max-width: 720px;">
    <h1 class="h4 mb-3">Merchant Onboarding (Metinle)</h1>
    <p class="text-muted">
        Mağazayı DropShop ödeme gateway'ine metinle kaydedin. Örnek: "mağazayı gateway'e kaydet",
        "başvurum ne durumda?".
    </p>

    <div id="ob-messages" class="border rounded p-3 mb-3"
         style="height: 380px; overflow-y: auto; background:#fafafa;"></div>

    <form id="ob-form" class="d-flex gap-2">
        <input id="ob-input" type="text" class="form-control" autocomplete="off"
               placeholder="Bir şey yazın..." />
        <button type="submit" class="btn btn-primary">Gönder</button>
    </form>

    <hr class="my-4" />

    <h2 class="h5 mb-2">Merchant Kimliği</h2>
    <p class="text-muted">
        DropShop onayı sonrası aktivasyon sayfasında bir kez gösterilen merchantId + MerchantKey'i
        buraya girin. Key kaydedildikten sonra bir daha görüntülenmez.
    </p>

    @if (Model.StatusLoadFailed)
    {
        <div class="alert alert-warning py-2">Merchant kimliği durumu alınamadı.</div>
    }
    else if (Model.Current is null)
    {
        <div class="alert alert-secondary py-2">Kayıtlı merchant kimliği yok.</div>
    }
    else
    {
        <div class="alert alert-info py-2">
            Kayıtlı merchant: <code>@Model.Current.MerchantId</code>
            @if (Model.Current.UpdatedTime is not null)
            {
                <span> · Son güncelleme: @Model.Current.UpdatedTime.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            }
        </div>
    }

    @if (Model.MerchantKeyMessage is not null)
    {
        <div class="alert @(Model.MerchantKeySuccess ? "alert-success" : "alert-danger") py-2">
            @Model.MerchantKeyMessage
        </div>
    }

    <form method="post" asp-page-handler="SaveMerchantKey" autocomplete="off">
        <div class="mb-2">
            <label class="form-label" asp-for="MerchantKeyForm.MerchantId">MerchantId</label>
            <input class="form-control" asp-for="MerchantKeyForm.MerchantId"
                   placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="MerchantKeyForm.MerchantKey">MerchantKey</label>
            <input class="form-control" asp-for="MerchantKeyForm.MerchantKey" type="password"
                   placeholder="mk_..." value="" />
        </div>
        <button type="submit" class="btn btn-outline-primary">Kaydet</button>
    </form>
</div>

@section Scripts {
<script>
(function () {
    const form = document.getElementById('ob-form');
    const input = document.getElementById('ob-input');
    const messages = document.getElementById('ob-messages');
    // Cok turlu gecmis STATELESS: transkript sayfa-ici degiskende, her istekle gider
    // (sunucu previous_response_id cozmuyor — MAF hosting sinirlamasi, bkz. ChatEndpoints).
    // Sayfa yuklemesi = temiz oturum.
    const HIST_MAX = 40;
    let chatHistory = [];

    function addBubble(text, who) {
        const el = document.createElement('div');
        el.className = 'mb-2';
        el.innerHTML = '<strong>' + (who === 'user' ? 'Siz' : 'Asistan') + ':</strong> ';
        const span = document.createElement('span');
        span.textContent = text;
        el.appendChild(span);
        messages.appendChild(el);
        messages.scrollTop = messages.scrollHeight;
        return span;
    }

    function handleData(jsonText, botEl) {
        if (jsonText === '[DONE]') return;
        let obj;
        try { obj = JSON.parse(jsonText); } catch { return; }
        const type = typeof obj.type === 'string' ? obj.type : '';
        const isToolOrMeta = type.indexOf('function_call') !== -1 || type.indexOf('reasoning') !== -1;
        if (!isToolOrMeta) {
            if (typeof obj.delta === 'string') { botEl.textContent += obj.delta; }
            else if (obj.output_text && typeof obj.output_text === 'string') { botEl.textContent += obj.output_text; }
        }
        messages.scrollTop = messages.scrollHeight;
    }

    async function send(message) {
        addBubble(message, 'user');
        const botEl = addBubble('', 'bot');

        let resp;
        try {
            resp = await fetch('/chat/admin/stream', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message, history: chatHistory })
            });
        } catch {
            botEl.textContent = 'Üzgünüm, şu an yardımcı olamıyorum.';
            return;
        }
        if (!resp.ok || !resp.body) { botEl.textContent = 'Üzgünüm, şu an yardımcı olamıyorum.'; return; }

        const reader = resp.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const parts = buffer.split('\n\n');
            buffer = parts.pop();
            for (const part of parts) {
                for (const line of part.split('\n')) {
                    const trimmed = line.trim();
                    if (trimmed.indexOf('data:') === 0) {
                        handleData(trimmed.slice(5).trim(), botEl);
                    }
                }
            }
        }
        if (botEl.textContent === '') botEl.textContent = '(boş yanıt)';

        // Turu transkripte isle — sonraki istek gecmisi tasir.
        chatHistory.push({ role: 'user', content: message });
        chatHistory.push({ role: 'assistant', content: botEl.textContent });
        chatHistory = chatHistory.slice(-HIST_MAX);
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const message = input.value.trim();
        if (!message) return;
        input.value = '';
        send(message);
    });
})();
</script>
}