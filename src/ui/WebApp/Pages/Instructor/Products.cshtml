@page
@model WebApp.Pages.Instructor.ProductsModel
@{
    Layout = "_Instructor_Layout";
}

<table class="table table-striped">
    <thead>
    <tr>
        <th scope="col">#</th>
        <td>Picture</td>
        <th scope="col">Name</th>
        <th scope="col">Description</th>
        <th scope="col">Price</th>
        <th scope="col">Brand</th>
        <th scope="col">SKU</th>
        <th scope="col">Actions</th>
    </tr>
    </thead>
    <tbody>
    @if (Model.ProductViewModels.Any())
    {
        var index = 1;
        foreach (var product in Model.ProductViewModels)
        {
            <tr>
                <th scope="row">@index</th>
                <td>
                    <img width="100px" class="img-fluid img-thumbnail" alt="@product.Name"
                         src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/blank_course_thumbnail.jpg" : product.ImageUrl)">
                </td>
                <td>@product.Name</td>
                <td>@product.TruncateDescription(100)</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Brand</td>
                <td>@product.Sku</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page-handler="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </td>
            </tr>
            index++;
        }
    }
    else
    {
        <tr>
            <td colspan="8" class="text-center">No products available.</td>
        </tr>
    }
    </tbody>
</table>