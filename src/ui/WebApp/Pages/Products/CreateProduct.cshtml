@page
@model WebApp.Pages.Products.CreateProductModel
@{
}

<div class="row">
    <h2>Create Product</h2>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning text-bg-warning border-warning"></div>
    <form method="post">
        <div class="mb-3">
            <label asp-for="ViewModel.Name" class="form-label"></label>
            <input asp-for="ViewModel.Name" class="form-control">
            <span asp-validation-for="ViewModel.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ViewModel.Description" class="form-label"></label>
            <textarea asp-for="ViewModel.Description" class="form-control"></textarea>
            <span asp-validation-for="ViewModel.Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.Brand" class="form-label"></label>
            <select asp-for="ViewModel.Brand" class="form-select" asp-items="@Model.ViewModel.BrandDropdownList">
                <option value="">Select Brand</option>
            </select>
            <span asp-validation-for="ViewModel.Brand" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.Sku" class="form-label"></label>
            <input asp-for="ViewModel.Sku" class="form-control">
            <span asp-validation-for="ViewModel.Sku" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.Price" class="form-label"></label>
            <input asp-for="ViewModel.Price" class="form-control" type="number" step="0.01">
            <span asp-validation-for="ViewModel.Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.InitialStock" class="form-label"></label>
            <input asp-for="ViewModel.InitialStock" class="form-control" type="number">
            <span asp-validation-for="ViewModel.InitialStock" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ViewModel.ImageUrl" class="form-label"></label>
            <input asp-for="ViewModel.ImageUrl" class="form-control">
            <span asp-validation-for="ViewModel.ImageUrl" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create Product</button>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("Shared/_ValidationScriptsPartial");
    }
}