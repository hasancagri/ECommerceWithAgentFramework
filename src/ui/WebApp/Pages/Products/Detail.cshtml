@page "{id:guid}"
@model WebApp.Pages.Products.DetailModel
@{
}
<div class="container mt-5">

    <div class="row">


        <div class="col-md-6">
            <div class="card shadow-lg border-0">

                <img class="card-img-top product-detail-img" alt="@Model.Product!.Name"
                     src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/NoImage.jpeg" : Model.Product.ImageUrl)">
                <div class="card-body">
                    <h2 class="mb-4">@Model.Product.Name</h2>
                    <h5 class="card-title">Açıklama</h5>
                    <p>@Model.Product.Description</p>
                </div>
            </div>
        </div>


        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body">

                    <h5 class="card-title">Marka</h5>
                    <p class="card-text">@Model.Product.Brand</p>
                    <hr>

                    <h5 class="card-title">Kategori</h5>
                    <p class="card-text">@Model.Product.Category</p>
                    <hr>

                    <h5 class="card-title">Fiyat</h5>
                    <p class="card-text">
                        <strong>@Model.Product.Price.ToString("C")</strong>
                    </p>
                    <hr>

                    <h5 class="card-title">Stok</h5>
                    <p class="card-text">
                        @* 012 (US5): Available'dan turetilmis stok rozeti — az kaldiginda "son N adet". *@
                        @if (Model.StockQuantity <= 0)
                        {
                            <span class="badge bg-danger">Stokta yok</span>
                        }
                        else if (Model.StockQuantity <= 5)
                        {
                            <span class="badge bg-warning text-dark">Son @Model.StockQuantity adet</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Stokta: @Model.StockQuantity</span>
                        }
                    </p>
                    <hr>

                    @if (Model.StockQuantity > 0)
                    {
                        <a asp-page="/basket/index" asp-page-handler="AddBasket" asp-route-productId="@Model.Product.Id"
                           class="btn btn-primary">Sepete Ekle</a>
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled>Sepete Ekle</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>