@page "{id:guid}"
@model WebApp.Pages.Products.DetailModel
@{
    ViewData["Title"] = Model.Product?.Name;
}
<div class="container mt-4">

    @* --- Künye: kapak + bilgi --- *@
    <div class="row g-4 kp-detail">
        <div class="col-md-4">
            <div class="kp-detail-cover">
                <img alt="@Model.Product!.Name"
                     onerror="this.onerror=null;this.src='/images/NoImage.jpeg';"
                     src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/NoImage.jpeg" : Model.Product.ImageUrl)">
            </div>
        </div>

        <div class="col-md-8">
            <h1 class="kp-detail-title">@Model.Product.Name</h1>

            <div class="kp-detail-meta">
                @if (Model.Product.Authors.Count > 0)
                {
                    <div><span class="kp-detail-label">Yazar:</span>
                        @for (var i = 0; i < Model.Product.Authors.Count; i++)
                        {
                            var author = Model.Product.Authors[i];
                            <a asp-page="/Products/Index" asp-route-authorId="@author.Id">@author.Name</a>@(i < Model.Product.Authors.Count - 1 ? ", " : "")
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Product.Publisher))
                {
                    <div><span class="kp-detail-label">Yayınevi:</span>
                        <a asp-page="/Products/Index" asp-route-publisherId="@Model.Product.PublisherId">@Model.Product.Publisher</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Product.Category))
                {
                    <div><span class="kp-detail-label">Kategori:</span>
                        <a asp-page="/Products/Index" asp-route-categoryId="@Model.Product.CategoryId">@Model.Product.Category</a>
                    </div>
                }
            </div>

            @if (Model.Product.RatingCount > 0 && Model.Product.RatingAverage is not null)
            {
                <p class="kp-detail-rating mb-2">
                    <span class="text-warning">★</span>
                    <strong>@Model.Product.RatingAverage.Value.ToString("0.0")</strong>
                    <span class="text-muted">(@Model.Product.RatingCount yorum)</span>
                </p>
            }

            <div class="kp-detail-price">@Model.Product.Price.ToString("C")</div>

            <p class="mb-3">
                @if (Model.StockQuantity <= 0)
                {
                    <span class="badge bg-danger">Stokta yok</span>
                }
                else if (Model.StockQuantity <= 5)
                {
                    <span class="badge bg-warning text-dark">Son @Model.StockQuantity adet</span>
                }
                else
                {
                    <span class="badge bg-success">Stokta</span>
                }
            </p>

            @* 045: varyant seçici — yalnız aileli üründe. *@
            @if (Model.Family is { HasSelector: true })
            {
                foreach (var selector in Model.Family.BuildSelectors())
                {
                    <div class="mb-2">
                        <div class="fw-semibold small mb-1">@selector.Attribute</div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var opt in selector.Options)
                            {
                                @if (opt.IsCurrent)
                                {
                                    <span class="btn btn-sm kp-detail-add disabled">@opt.Value</span>
                                }
                                else if (opt.TargetProductId is not null)
                                {
                                    <a class="btn btn-outline-secondary btn-sm @(opt.IsInStock ? "" : "opacity-50")"
                                       asp-page="/Products/Detail" asp-route-id="@opt.TargetProductId">
                                        @opt.Value@(opt.IsInStock ? "" : " (stok yok)")
                                    </a>
                                }
                                else
                                {
                                    <span class="btn btn-outline-secondary btn-sm disabled">@opt.Value</span>
                                }
                            }
                        </div>
                    </div>
                }
            }

            @if (Model.StockQuantity > 0)
            {
                <a asp-page="/basket/index" asp-page-handler="AddBasket" asp-route-productId="@Model.Product.ProductId"
                   class="btn kp-detail-add btn-lg">🛒 Sepete Ekle</a>
            }
            else
            {
                <button class="btn kp-detail-add btn-lg" disabled>Sepete Ekle</button>
            }
        </div>
    </div>

    @* --- Açıklama + özellikler --- *@
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="kp-section-title">Kitap Hakkında</h5>
                    <p>@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "Açıklama yok." : Model.Product.Description)</p>

                    @if (Model.Product.Specs is { Count: > 0 })
                    {
                        <h5 class="kp-section-title mt-4">Özellikler</h5>
                        <table class="table table-sm mb-0">
                            <tbody>
                            @foreach (var spec in Model.Product.Specs)
                            {
                                <tr>
                                    <th scope="row" class="fw-semibold w-25">@spec.Attribute</th>
                                    <td>@spec.Option</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    @* 044: yorumlar — liste herkese acik; form yalniz uygun (satin almis) login'li kullaniciya. *@
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="kp-section-title mb-3">Yorumlar</h5>

                    @if (!string.IsNullOrEmpty(Model.ReviewSuccess))
                    {
                        <div class="alert alert-success">@Model.ReviewSuccess</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ReviewError))
                    {
                        <div class="alert alert-danger">@Model.ReviewError</div>
                    }

                    @if (Model.CanReview)
                    {
                        <form method="post" asp-page-handler="Review" asp-route-id="@Model.Product.ProductId"
                              class="mb-4">
                            <div class="mb-2">
                                <label class="form-label fw-semibold">Puanınız</label>
                                <select name="rating" class="form-select w-auto">
                                    <option value="5">★★★★★ (5)</option>
                                    <option value="4">★★★★ (4)</option>
                                    <option value="3">★★★ (3)</option>
                                    <option value="2">★★ (2)</option>
                                    <option value="1">★ (1)</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-semibold">Yorumunuz (isteğe bağlı)</label>
                                <textarea name="text" class="form-control" rows="3" maxlength="2000"></textarea>
                            </div>
                            <button type="submit" class="btn kp-detail-add">Yorumu Gönder</button>
                        </form>
                        <hr>
                    }

                    @if (Model.Reviews.Reviews.Count == 0)
                    {
                        <p class="text-muted mb-0">Henüz yorum yok.</p>
                    }
                    else
                    {
                        @foreach (var review in Model.Reviews.Reviews)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <strong>@review.MaskedName</strong>
                                    <span class="badge bg-success-subtle text-success border">Doğrulanmış alışveriş</span>
                                    <small class="text-muted">@review.CreatedTime.ToString("dd.MM.yyyy")</small>
                                </div>
                                <div class="text-warning">
                                    @string.Concat(Enumerable.Repeat("★", review.Rating))<span
                                        class="text-muted">@string.Concat(Enumerable.Repeat("☆", 5 - review.Rating))</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Text))
                                {
                                    <p class="mb-0 mt-1">@review.Text</p>
                                }
                            </div>
                        }

                        @if (Model.Reviews.PageCount > 1)
                        {
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    @for (var p = 1; p <= Model.Reviews.PageCount; p++)
                                    {
                                        <li class="page-item @(p == Model.Reviews.PageNumber ? "active" : "")">
                                            <a class="page-link" asp-page="/Products/Detail"
                                               asp-route-id="@Model.Product.ProductId"
                                               asp-route-reviewsPage="@p">@p</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* 055: detay ziyareti cihaz-yerel "son gezdiklerim" listesine yazılır (en yeni başta, ≤10,
   tekrar ziyaret öne taşır). Sunucuya sinyal GİTMEZ; bozuk kayıt listeyi sıfırlar (FR-009). *@
@section Scripts {
    @if (Model.Product is not null)
    {
        <script>
            (function () {
                const KEY = 'recentlyViewed';
                const id = '@Model.Product.ProductId';
                let list;
                try { list = JSON.parse(localStorage.getItem(KEY)); } catch { list = null; }
                if (!Array.isArray(list)) list = [];
                list = [id, ...list.filter(x => typeof x === 'string' && x !== id)].slice(0, 10);
                localStorage.setItem(KEY, JSON.stringify(list));
            })();
        </script>
    }
}
