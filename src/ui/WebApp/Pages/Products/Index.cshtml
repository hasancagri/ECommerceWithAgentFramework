@page
@using WebApp.ViewModel
@model WebApp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "All Products";
}

<div class="container mt-5">
    <h2 class="mb-4">All Products</h2>

    @* 016 US1: kategori filtresi — seçenekler gerçek veriden; seçim yeni GET ile 1. sayfadan başlar. *@
    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var category in Model.FilterOptions.Categories)
                {
                    <option value="@category.Id" selected="@(category.Id == Model.SelectedCategoryId)">
                        @category.Name
                    </option>
                }
            </select>
        </div>
        @if (Model.SelectedCategoryId is not null)
        {
            <div class="col-auto">
                <a class="btn btn-outline-secondary" href="/Products">Clear</a>
            </div>
        }
    </form>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (!Model.Products.Any())
        {
            <div class="col">
                <div class="alert alert-warning" role="alert">
                    No Products Found!
                </div>
            </div>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product"/>
            }
        }
    </div>

    <partial name="_Pager" model="new PagerViewModel(Model.PageNumber, Model.PageCount, Model.FilterQuery)"/>
</div>