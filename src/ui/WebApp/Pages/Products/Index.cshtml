@page
@using WebApp.ViewModel
@model WebApp.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Tüm Ürünler";
}

<div class="container mt-5">
    <h2 class="mb-4">Tüm Ürünler</h2>

    @* 016 US1/US2: kategori+marka filtreleri (AND) — seçenekler gerçek veriden; seçim yeni GET ile 1. sayfadan başlar. *@
    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in Model.FilterOptions.Categories)
                {
                    <option value="@category.Id" selected="@(category.Id == Model.SelectedCategoryId)">
                        @category.Name
                    </option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select name="brandId" class="form-select" onchange="this.form.submit()">
                <option value="">Tüm Markalar</option>
                @foreach (var brand in Model.FilterOptions.Brands)
                {
                    <option value="@brand.Id" selected="@(brand.Id == Model.SelectedBrandId)">
                        @brand.Name
                    </option>
                }
            </select>
        </div>
        @if (Model.SelectedCategoryId is not null || Model.SelectedBrandId is not null || Model.SelectedSpecs.Count > 0)
        {
            <div class="col-auto">
                <a class="btn btn-outline-secondary" href="/Products">Temizle</a>
            </div>
        }

        @* 043 US1: spec facet'leri — aynı özellik içi OR, özellikler arası AND; seçim yeni GET ile gider. *@
        @if (Model.FilterOptions.Specifications.Count > 0)
        {
            <div class="col-12">
                <div class="row g-3 mt-1">
                    @foreach (var facet in Model.FilterOptions.Specifications)
                    {
                        <div class="col-auto">
                            <div class="fw-semibold small mb-1">@facet.Name</div>
                            @foreach (var option in facet.Options)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="spec"
                                           value="@option.Key" id="spec-@option.Key.GetHashCode()"
                                           checked="@Model.SelectedSpecs.Contains(option.Key)"
                                           onchange="this.form.submit()"/>
                                    <label class="form-check-label small" for="spec-@option.Key.GetHashCode()">
                                        @option.Name (@option.Count)
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </form>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (!Model.Products.Any())
        {
            <div class="col">
                <div class="alert alert-warning" role="alert">
                    Ürün bulunamadı!
                </div>
            </div>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product"/>
            }
        }
    </div>

    <partial name="_Pager" model="new PagerViewModel(Model.PageNumber, Model.PageCount, Model.FilterQuery)"/>
</div>