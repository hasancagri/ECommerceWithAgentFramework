@using System.Security.Claims
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/chat-widget.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">WebApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-page="/Index">Ana Sayfa</a>
                    </li>
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        @await Component.InvokeAsync("BasketCountdown")
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">


                                <li>
                                    <a class="dropdown-item" asp-page="/Basket/Index">Sepetim</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Account/Profile">Profilim</a>
                                </li>
                                @* 030 RBAC: admin'e yönetim paneli girişi (IdP /Admin/Roles). *@
                                @if (User.IsInRole("admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" href="https://localhost:5001/Admin/Roles">Yönetim Paneli</a>
                                    </li>
                                    @* 032: admin metinle merchant onboarding ekrani. *@
                                    <li>
                                        <a class="dropdown-item" asp-page="/Admin/Onboarding">Merchant Onboarding</a>
                                    </li>
                                }
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Auth/SignIn" asp-page-handler="SignOut">Çıkış Yap</a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Auth/SignIn">Giriş Yap</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Auth/SignUp">Kayıt Ol</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">


        <partial name="_Error"/>
        <partial name="_Success"/>
        @RenderBody()
    </main>
</div>

<partial name="_ChatWidget"/>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/basket-countdown.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", false)
</body>
</html>