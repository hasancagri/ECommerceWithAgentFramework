@model WebApp.ViewModel.StorefrontProductViewModel

@* 011: ana sayfa ve Tüm Ürünler aynı kartı çizer (FR-008); 006 rozet kuralları korunur. *@
<div class="col">
    <div class="card h-100 shadow-lg border-0">
        <a asp-page="/Products/Detail" asp-route-id="@Model.ProductId">
            <img
                src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/NoImage.jpeg" : Model.ImageUrl)"
                class="card-img-top product-thumb" alt="@Model.Name">
        </a>

        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            @* 044: yildiz rozeti — yorumsuz urunde cizilmez (FR-006). *@
            @if (Model.RatingCount > 0 && Model.RatingAverage is not null)
            {
                <p class="card-text mb-1">
                    <span class="text-warning">★</span>
                    <strong>@Model.RatingAverage.Value.ToString("0.0")</strong>
                    <small class="text-muted">(@Model.RatingCount)</small>
                </p>
            }
            @* 045: varyant ailesi rozeti — >1 uye varsa cizilir (FR-008). *@
            @if (Model.VariantCount > 1)
            {
                <p class="card-text mb-1">
                    <span class="badge bg-primary-subtle text-primary border">@Model.VariantCount varyant</span>
                </p>
            }
            <p class="card-text">
                @* FR-009: stok null = bilinmiyor, rozet yok; 0 = stokta yok; >0 = stokta. *@
                @if (Model.IsInStock == true)
                {
                    <span class="badge bg-success">Stokta</span>
                }
                else if (Model.IsInStock == false)
                {
                    <span class="badge bg-secondary">Stokta Yok</span>
                }
                @* 016: kategori rozeti; null/boş = Catalog raporlamadı, çizilmez. *@
                @* Id varsa rozet o kategoriye filtreli /Products'a link olur (tek facet). *@
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    @if (Model.CategoryId is not null)
                    {
                        <a asp-page="/Products/Index" asp-route-categoryId="@Model.CategoryId"
                           class="badge bg-info text-decoration-none">@Model.Category</a>
                    }
                    else
                    {
                        <span class="badge bg-info">@Model.Category</span>
                    }
                }
            </p>
            <p class="card-text">@Model.TruncateDescription(100)</p>
            <p class="card-text">
                @* Id varsa marka o markaya filtreli /Products'a link olur (tek facet). *@
                <small class="text-muted">Marka:
                    @if (Model.BrandId is not null)
                    {
                        <a asp-page="/Products/Index" asp-route-brandId="@Model.BrandId"><strong>@Model.Brand</strong></a>
                    }
                    else
                    {
                        <strong>@Model.Brand</strong>
                    }
                </small>
            </p>
            <p class="card-text">
                <strong>@Model.Price.ToString("C")</strong>
            </p>
        </div>
        <div class="card-footer">
            <a asp-page="/Products/Detail" asp-route-id="@Model.ProductId" class="btn btn-primary mt-2">Detay</a>
        </div>
    </div>
</div>