@model WebApp.ViewModel.StorefrontProductViewModel

@* 011: ana sayfa ve Tüm Ürünler aynı kartı çizer (FR-008); 006 rozet kuralları korunur. *@
<div class="col">
    <div class="card h-100 shadow-lg border-0">
        <a asp-page="/Products/Detail" asp-route-id="@Model.ProductId">
            <img
                src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/NoImage.jpeg" : Model.ImageUrl)"
                class="card-img-top product-thumb" alt="@Model.Name">
        </a>

        <div class="card-body">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text">
                @* FR-009: stok null = bilinmiyor, rozet yok; 0 = stokta yok; >0 = stokta. *@
                @if (Model.IsInStock == true)
                {
                    <span class="badge bg-success">In Stock</span>
                }
                else if (Model.IsInStock == false)
                {
                    <span class="badge bg-secondary">Out of Stock</span>
                }
                @* DiscountRate 0-100 arası yüzdedir (Discount.DiscountRate VO) — çarpan yok. *@
                @if (Model.DiscountRate is not null)
                {
                    <span class="badge bg-danger">%@(Model.DiscountRate.Value.ToString("0.#")) Off</span>
                }
                @* 016: kategori rozeti; null/boş = Catalog raporlamadı, çizilmez. *@
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <span class="badge bg-info">@Model.Category</span>
                }
            </p>
            <p class="card-text">@Model.TruncateDescription(100)</p>
            <p class="card-text">
                <small class="text-muted">Brand: <strong>@Model.Brand</strong></small>
            </p>
            <p class="card-text">
                <strong>@Model.Price.ToString("C")</strong>
            </p>
        </div>
        <div class="card-footer">
            <a asp-page="/Products/Detail" asp-route-id="@Model.ProductId" class="btn btn-primary mt-2">Show
                Detail</a>
        </div>
    </div>
</div>