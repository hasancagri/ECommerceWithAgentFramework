@model WebApp.ViewModel.HomeShelfViewModel
@{
    var shelfIndex = ViewData["ShelfIndex"] as int? ?? 0;
    var isColdStart = ViewData["IsColdStart"] as bool? ?? false;
    // Cold-start (herkese-aynı popüler) kuşağında kişisel "daha fazla" mantıksız; buton yalnız kişiselde.
    var showLoadMore = !isColdStart;
}

@* 053: tek öneri kuşağı — başlık + gerekçe (FR-018) + kart ızgarası + waterfall load-more butonu. *@
<section class="kp-band">
    <div class="kp-band-head">
        <div>
            <h3 class="kp-band-title">@Model.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Reason))
            {
                <div class="kp-band-reason text-muted small">@Model.Reason</div>
            }
        </div>
    </div>
    <div id="shelf-grid-@shelfIndex" class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
        <partial name="_ShelfCards" model="Model.Products"/>
    </div>
    @if (showLoadMore && Model.Products.Count > 0)
    {
        <div class="text-center mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-shelf="@shelfIndex" data-offset="@Model.Products.Count"
                    onclick="loadMoreShelf(this)">
                Daha fazla göster
            </button>
        </div>
    }
</section>
