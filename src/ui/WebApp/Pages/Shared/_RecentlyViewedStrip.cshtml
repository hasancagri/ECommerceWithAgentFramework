@model List<WebApp.ViewModel.StorefrontProductViewModel>

@* 055: cihaz-yerel "son gezdiklerim" şeridi — sıra istemcinin gönderdiği sıradır (en yeni önce).
   Satın alınan ürün elenmez (gezilen şey hatıradır); kartlar mevcut _ProductCard ile çizilir. *@
<div class="mt-5">
    <div class="d-flex align-items-baseline justify-content-between mb-3">
        <h2 class="mb-0">Son Gezdiklerim</h2>
        @* FR-010: temizle — enjekte HTML'de script çalışmaz; Index'teki delegasyon dinler. *@
        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0"
                data-clear-recently-viewed>Temizle</button>
    </div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product"/>
        }
    </div>
</div>