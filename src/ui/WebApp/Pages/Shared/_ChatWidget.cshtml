@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<div id="chat-widget" data-authenticated="@(isAuthenticated ? "true" : "false")">
    <button id="chat-toggle" type="button" aria-label="Help">💬</button>
    <div id="chat-panel" class="chat-hidden">
        <div id="chat-header">
            <span>Assistant</span>
            <span class="chat-header-actions">
                @if (isAuthenticated)
                {
                    <button id="chat-history-toggle" type="button" aria-label="History" title="Geçmiş konuşmalar">🕘</button>
                }
                <button id="chat-new" type="button" aria-label="New chat" title="Yeni sohbet">＋</button>
                <button id="chat-close" type="button" aria-label="Close">×</button>
            </span>
        </div>
        @if (isAuthenticated)
        {
            <div id="chat-history" class="chat-hidden"></div>
        }
        <div id="chat-messages"></div>
        <form id="chat-form">
            <input id="chat-input" type="text" autocomplete="off"
                   placeholder="Ask something..." />
            <button type="submit">Send</button>
        </form>
    </div>
</div>