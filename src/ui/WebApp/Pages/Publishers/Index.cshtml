@page
@model WebApp.Pages.Publishers.IndexModel
@{
    ViewData["Title"] = "Yayınevleri";
}

<div class="container mt-4">
    <div class="d-flex align-items-baseline justify-content-between flex-wrap mb-3">
        <h2 class="mb-0">Yayınevleri</h2>
        <span class="text-muted small">@Model.TotalPublishers yayınevi</span>
    </div>

    @* NOT: "Çok Satan Yayınevleri" (son 30 gün satış) = ertelenen davranış feature'ı; burası A-Z gezilebilir dizin. *@

    @* Sayfa-içi arama — görüntülenen harfin listesini istemci-tarafı süzer. *@
    <input type="search" id="publisherSearch" class="form-control kp-index-search mb-3"
           placeholder="Bu harfteki yayınevlerinde ara..." aria-label="Yayınevi ara"/>

    @* A-Z harf indeksi. *@
    <div class="kp-letters mb-4">
        @foreach (var l in "ABCDEFGHIJKLMNOPQRSTUVWXYZ#".Select(c => c.ToString()))
        {
            @if (Model.Letters.Contains(l))
            {
                <a class="kp-letter @(l == Model.SelectedLetter ? "active" : "")"
                   asp-page="/Publishers/Index" asp-route-letter="@l">@l</a>
            }
            else
            {
                <span class="kp-letter disabled">@l</span>
            }
        }
    </div>

    @if (Model.PublishersForLetter.Count == 0)
    {
        <div class="alert alert-warning">Bu harfte yayınevi yok.</div>
    }
    else
    {
        <div class="kp-index-grid" id="publisherList">
            @foreach (var publisher in Model.PublishersForLetter)
            {
                <a class="kp-index-item" asp-page="/Products/Index" asp-route-publisherId="@publisher.Id">@publisher.Name</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Sayfa-içi filtre: görüntülenen harfin yayınevlerini istemci-tarafı ada göre süzer.
        (function () {
            const box = document.getElementById('publisherSearch');
            const items = Array.from(document.querySelectorAll('#publisherList .kp-index-item'));
            if (!box) return;
            box.addEventListener('input', function () {
                const q = this.value.trim().toLowerCase();
                items.forEach(function (el) {
                    el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none';
                });
            });
        })();
    </script>
}
