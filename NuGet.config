<?xml version="1.0" encoding="utf-8"?>
<!-- 084: Platform.Auth paylaşılan paketi yerel dosya-sistemi feed'inden (AgentPlatform üretir).
     Namespace'ler Common.* olduğundan tüketici servislerde using değişmez. Credential yok. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="../local-nuget" />
  </packageSources>
</configuration>
